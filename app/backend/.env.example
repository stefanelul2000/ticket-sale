# Production-safe defaults. In Docker the container environment (docker-compose.yml)
# overrides these; this file only seeds /config/app.env (APP_KEY lives there).
APP_NAME="Bilete Atelier Săcelean"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Europe/Bucharest
APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# First-run wizard asks for DB credentials only when true.
SETUP_ENABLED=true
REGISTRATION_ENABLED=false
API_DOCS_ENABLED=false
L5_SWAGGER_USE_ABSOLUTE_PATH=false
GENERATE_L5_SWAGGER_ON_STARTUP=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ticket_sale
DB_USERNAME=ticket_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
