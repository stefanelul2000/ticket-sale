# Copy outside the repo, fill in, and pass with --env-file.
APP_IMAGE=ticket-sale:local
APP_URL=https://ticket.example.com
SANCTUM_STATEFUL_DOMAINS=ticket.example.com
APP_BIND=8080
DATA_DIR=/srv/ticket-sale
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
PUID=1000
PGID=1000
TZ=Europe/Bucharest
SESSION_SECURE_COOKIE=true
# External DB instead of the bundled one (use docker-compose.external-db.yml):
# DB_HOST=mariadb
# DB_NETWORK=database
# DB_CONTAINER=mariadb   # used by scripts/backup-db.sh
# Email via Microsoft 365 (Entra app with Graph Mail.Send, restricted to the sender mailbox):
# MAIL_MAILER=microsoft-graph
# MAIL_FROM_ADDRESS=office@example.org
# MAIL_FROM_NAME="Asociatia Atelier Sacelean"
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=office@example.org
